# =================================================================
# HOSPITAL INTELLIGENCE PLATFORM (HIP) - ENVIRONMENT TEMPLATE
# Copy this file to '.env' and fill in your actual private credentials.
# DO NOT COMMIT YOUR REAL '.env' FILE TO GITHUB!
# =================================================================

# --- DATABASE PERSISTENCE LAYER (ASYNC SUPABASE / POSTGRESQL) ---
# Supabase Transaction Pooler URL (Port 6543 recommended) or Session Pooler (Port 5432):
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres.your_project_ref:your_secure_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Local PostgreSQL Configuration (Only needed if running local Postgres container)
POSTGRES_USER=hip_admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=hospital_intelligence

# --- AUTHENTICATION & SECURITY ---
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CACHING & PUB/SUB LAYER (REDIS) ---
REDIS_URL=redis://hip-redis:6379

# --- INTERNAL MICROSERVICE MESH ENDPOINTS ---
AUTH_SERVICE_URL=http://hip-auth-service:8001
PATIENT_SERVICE_URL=http://hip-patient-service:8002
BED_SERVICE_URL=http://hip-bed-service:8003
