# =================================================================
# HOSPITAL INTELLIGENCE PLATFORM (HIP) - ENVIRONMENT TEMPLATE
# Copy this file to '.env' and fill in your actual private credentials.
# DO NOT COMMIT YOUR REAL '.env' FILE TO GITHUB!
# =================================================================

# --- DATABASE PERSISTENCE LAYER (ASYNC SUPABASE / POSTGRESQL) ---
# Supabase Transaction Pooler URL (Port 6543 recommended) or Session Pooler (Port 5432):
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or Local Docker Network URL:
DATABASE_URL=postgresql+asyncpg://hip_admin:your_secure_password_here@hip-postgres:5432/hospital_intelligence

# Migration / Host Connection URL (used by Alembic or host test scripts connecting via port 5431)
ALEMBIC_DATABASE_URL=postgresql+asyncpg://hip_admin:your_secure_password_here@localhost:5431/hospital_intelligence
TEST_PG_DSN=postgresql://hip_admin:your_secure_password_here@localhost:5431/hospital_intelligence

# Local PostgreSQL Container Credentials
POSTGRES_USER=hip_admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=hospital_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5431

# --- AUTHENTICATION & SECURITY ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
TEST_USER_PASSWORD=SecurePassword123!
INITIAL_ADMIN_PASSWORD=replace_with_a_secure_admin_password

# --- CACHING & PUB/SUB LAYER (REDIS) ---
# Generate REDIS_PASSWORD with: python -c "import secrets; print(secrets.token_hex(16))"
REDIS_PASSWORD=replace_with_a_secure_random_hex_string
REDIS_URL=redis://:${REDIS_PASSWORD}@hip-redis:6379

# --- CORS ORIGINS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- INTERNAL MICROSERVICE MESH ENDPOINTS ---
AUTH_SERVICE_URL=http://hip-auth-service:8001
PATIENT_SERVICE_URL=http://hip-patient-service:8002
BED_SERVICE_URL=http://hip-bed-service:8003
GATEWAY_URL=http://localhost:8080

# --- INTER-SERVICE MESH TRUST ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Shared secret for verifying internal service-to-service calls (e.g., bed-service -> patient-service)
INTERNAL_SERVICE_SECRET=replace_with_a_secure_random_64_character_hex_string
